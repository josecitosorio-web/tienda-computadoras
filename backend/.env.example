# Puerto del servidor backend
PORT=3000

# Cadena de conexión a MongoDB (local o Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/tienda_computadoras_db

# Origen permitido para CORS (la URL del frontend)
FRONTEND_URL=http://localhost:5173

# Tasa de impuesto aplicada a las ventas (0.18 = 18% IGV, 0 = sin impuesto)
TAX_RATE=0

# Moneda usada en la interfaz y comprobantes
CURRENCY=PEN

# Datos de la tienda mostrados en el comprobante interno
TIENDA_NOMBRE=Tienda de Computadoras
TIENDA_RUC=00000000000
TIENDA_DIRECCION=Av. Principal 123, Lima
TIENDA_TELEFONO=(01) 555-0000
TIENDA_CORREO=ventas@tiendacomputadoras.pe

# Entorno de ejecución
NODE_ENV=development
